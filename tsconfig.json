{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true
    // Every dependency resolves through its own `exports` map now — weasel's
    // answers the barrel and the `@weasel-js/ui/components/*` subpaths, and
    // bil-lbx ships its own types — so nothing here mirrors a source layout.
  },
  "include": ["src"]
}
